REGISTER_ENABLED=1
MYSQL_ROOT_PASSWORD=GENERATE_ME
MYSQL_PASSWORD=GENERATE_ME
ELASTIC_PASSWORD=GENERATE_ME
MINIO_PASSWORD=GENERATE_ME
REDIS_PASSWORD=GENERATE_ME
RAGFLOW_SECRET_KEY=GENERATE_ME
